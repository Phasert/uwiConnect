# Legacy filename — prefer `.env.example`.
# Kept so older docs/scripts that copy `env.example` still work.
DATABASE_URI="sqlite:///database.db"
SECRET_KEY="YouShouldChangeThisSecretKeyToSomethingLongAndRandom"
ENV="development"
APP_PORT=5000
APP_BASE_URL="http://127.0.0.1:5000"
# Ops console at /config — leave empty to disable the panel
CONFIG_PASSWORD=""
# Gmail SMTP — use a Google-generated App Password, never your account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="UWI Connect"
SMTP_FROM_ADDRESS=""
SMTP_USE_TLS=true
SMTP_USE_IMPLICIT_TLS=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT=10
