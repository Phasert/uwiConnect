DATABASE_URI="sqlite:///database.db"
SECRET_KEY="YouShouldChangeThisSecretKeyToSomethingLongAndRandom"
ENV="development"
APP_PORT=5000
APP_BASE_URL="http://127.0.0.1:5000"
# Ops console at /config — leave empty to disable the panel
CONFIG_PASSWORD=""
# Gmail SMTP — use a Google-generated App Password, never your account password.
# SMTP_FROM_EMAIL and SMTP_USE_TLS replace the old *_ADDRESS / *_IMPLICIT_TLS / *_STARTTLS names.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="UWI Connect"
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
NOTIFICATION_EMAIL_ENABLED=false
